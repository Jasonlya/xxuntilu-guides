# 本地开发用环境变量（复制为 .env.local，不要提交）
# Vault 路径：默认 ~/Documents/Obsidian Vault，可按需覆盖
VAULT_DIR=/Users/xxuntilu/Documents/Obsidian Vault

# 私密区主密码（≥ 8 位）。留空 = 私密笔记不进产物
VAULT_MASTER_PASSWORD=

# 自动归档（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# GitHub Pages 项目页子路径；本地留空
NEXT_PUBLIC_BASE_PATH=
